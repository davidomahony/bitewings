# CPU image for inference, preprocessing and short training smoke tests.
# Build from the repository root (with the onedl-mmdetection submodule checked out):
#   docker build -f docker/Dockerfile.cpu -t bitewings:cpu .
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        git build-essential ninja-build libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# same torch/torchvision versions as pip_requirements.txt, CPU build
RUN pip install --no-cache-dir torch==2.10.0 torchvision==0.25.0 \
        --index-url https://download.pytorch.org/whl/cpu

WORKDIR /app
COPY pip_requirements.txt mim_requirements.txt ./
RUN grep -vE '^(-f|torch|torchvision)' pip_requirements.txt > /tmp/requirements.txt \
    && pip install --no-cache-dir setuptools wheel -r /tmp/requirements.txt

# onedl-mmcv ships as source only; build its C++ ops without CUDA
ENV MMCV_WITH_OPS=1 FORCE_CUDA=0 MAX_JOBS=8
RUN pip install --no-cache-dir --no-build-isolation -r mim_requirements.txt

COPY onedl-mmdetection onedl-mmdetection
RUN pip install --no-cache-dir -e onedl-mmdetection
COPY . .

ENV BITEWINGS_DATA_ROOT=/data \
    BITEWINGS_CHECKPOINTS=/checkpoints \
    BITEWINGS_WORK_DIRS=/work_dirs
