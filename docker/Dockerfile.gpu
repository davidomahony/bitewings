# GPU (CUDA 12.9) image for training. Needs an NVIDIA GPU with >= 24 GB memory at run time,
# but builds on any machine. Build from the repository root:
#   docker build -f docker/Dockerfile.gpu -t bitewings:gpu .
# Building compiles onedl-mmcv's CUDA ops, which takes roughly 20-40 minutes.
FROM nvidia/cuda:12.9.1-cudnn-devel-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-dev python3-venv git build-essential ninja-build libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH

WORKDIR /app
COPY pip_requirements.txt mim_requirements.txt ./
# pip_requirements.txt pins the CUDA 12.9 build of torch 2.10
RUN pip install --no-cache-dir setuptools wheel -r pip_requirements.txt

# compile onedl-mmcv's CUDA ops for T4/RTX 20xx (7.5), A100 (8.0), A10/A4000/RTX 30xx (8.6),
# L4/L40/RTX 40xx (8.9) and H100 (9.0); no GPU is needed at build time. Building for only
# your GPU is faster, e.g. --build-arg TORCH_CUDA_ARCH_LIST=7.5 for a T4. Recent CUDA 12.x
# torch wheels have dropped older GPUs such as V100/P100: check that
# python -c "import torch; print(torch.cuda.get_arch_list())" lists your GPU's sm_XX.
ARG TORCH_CUDA_ARCH_LIST="7.5;8.0;8.6;8.9;9.0"
ENV MMCV_WITH_OPS=1 FORCE_CUDA=1 TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST} MAX_JOBS=8
RUN pip install --no-cache-dir --no-build-isolation -r mim_requirements.txt

COPY onedl-mmdetection onedl-mmdetection
RUN pip install --no-cache-dir -e onedl-mmdetection
COPY . .

ENV BITEWINGS_DATA_ROOT=/data \
    BITEWINGS_CHECKPOINTS=/checkpoints \
    BITEWINGS_WORK_DIRS=/work_dirs
